{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.lives-of-others.com" }],
      "destination": "https://lives-of-others.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/spa.html"
    }
  ],
  "functions": {
    "api/send-certificate.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/certificate-pdf.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
