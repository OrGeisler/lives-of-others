{
  "rewrites": [
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/send-certificate.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/certificate-pdf.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}