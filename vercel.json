{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.lives-of-others.com"
        }
      ],
      "destination": "https://lives-of-others.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/certificate-pdf",
      "destination": "/api/cert?op=pdf"
    },
    {
      "source": "/api/send-certificate",
      "destination": "/api/cert?op=send"
    },
    {
      "source": "/api/cron-gift-recipients",
      "destination": "/api/cert?op=cron"
    },
    {
      "source": "/certificate/:id",
      "destination": "/api/certificate-og?id=:id"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/spa.html"
    }
  ],
  "functions": {
    "api/cert.ts": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron-gift-recipients",
      "schedule": "0 6 * * *"
    }
  ]
}
